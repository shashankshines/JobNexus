# ==============================================================================
# JobNexus — Production Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or sensitive credentials to version control.
# ==============================================================================

# Application URL
# Used for canonical OAuth redirects, CORS, and callback verification
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session & Security Secret
# Cryptographically random string used for session hashing and encryption.
# In production, generate using: openssl rand -base64 32
SESSION_SECRET=your-secure-random-session-secret-at-least-32-chars

# Google Cloud OAuth 2.0 Client Credentials
# 1. Create a project in Google Cloud Console: https://console.cloud.google.com/
# 2. Configure OAuth Consent Screen (External, App Name: JobNexus)
# 3. Create Credentials -> OAuth client ID -> Web Application
# 4. Authorized JavaScript origins:
#    - Development: http://localhost:3000
#    - Production:  https://jobnexus.yourdomain.com
# 5. Authorized redirect URIs:
#    - Development: http://localhost:3000/api/auth/google/callback
#    - Production:  https://jobnexus.yourdomain.com/api/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret


# ==============================================================================
# Cloud Firestore & Firebase Admin SDK (Server-Side Only)
# ==============================================================================
# Authoritative database for JobNexus billing subscriptions and manual UPI flow.
# Project: jobnexus-98b60 (asia-south1)
FIREBASE_PROJECT_ID=jobnexus-98b60
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@jobnexus-98b60.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# Manual UPI Payment & Administrator Verification (Server-Side Only)
# ==============================================================================
# Business UPI configuration for manual UPI payments (₹499/month).
BUSINESS_UPI_ID=jobnexus@icici
BUSINESS_UPI_NAME=JobNexus

# Administrator emails authorized for payment verification & entitlement management (comma-separated)
ADMIN_EMAILS=admin@jobnexus.world

# Optional: Durable Storage Directory (Defaults to .jobnexus-data locally, /tmp on Vercel)
# JOBNEXUS_DATA_DIR=/path/to/persistent/storage
